{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigiAhan Golden Set Annotation Draft",
  "type": "object",
  "required": ["candidate_id", "segments", "entities", "review_status"],
  "properties": {
    "candidate_id": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "speaker_role", "text"],
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker_role": { "enum": ["AGENT", "CUSTOMER", "UNKNOWN"] },
          "text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "entities": { "type": "array", "items": { "type": "object" } },
    "objections": { "type": "array", "items": { "type": "object" } },
    "next_action": { "type": ["object", "null"] },
    "authoritative_outcome": { "type": ["object", "null"] },
    "review_status": { "enum": ["DRAFT", "DOUBLE_REVIEWED", "ADJUDICATED"] }
  },
  "additionalProperties": false
}
